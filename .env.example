# Public gift-box quotes remain disabled unless both values are configured.
GIFT_BOX_PUBLIC_QUOTES_ENABLED=false
# Set only in the hosting provider's encrypted secret manager. Never commit a key.
GIFT_BOX_QUOTE_PRIVATE_KEY=

# BurnFlip deployment and two-phase Katana V3 oracle configuration.
MATT_TOKEN_ADDRESS=
WRON_TOKEN_ADDRESS=
KATANA_V3_FACTORY=
BURNFLIP_TREASURY=
BURNFLIP_ADMIN=
BURNFLIP_REWARD_VAULT=
BURNFLIP_GAME_DEPLOYMENT=
BURNFLIP_CONFIG=
BURNFLIP_PREPARE_ONLY=false
# Set these only after deployment; the website keeps the replacement disabled until then.
BURNFLIP_CONTRACT_ADDRESS=
BURNFLIP_DEPLOYMENT_BLOCK=
BURNFLIP_STATS_CACHE_TTL_MS=15000
BURNFLIP_HISTORY_FILE=

# Project DYNO. Production refuses missing manifest values, database, identity secret, OAuth config, and signer.
DYNO_MANIFEST=config/project-dyno.local.json
DYNO_RPC_URL=http://127.0.0.1:8545
DYNO_CHAIN_ID=31337
DYNO_RAFFLE_ADDRESS=
DYNO_BUYBACK_ADDRESS=
DYNO_START_BLOCK=0
DYNO_FINALITY_BLOCKS=12
DATABASE_URL=postgres://dyno:dyno_local_only@127.0.0.1:5433/dyno
# Local legacy PostgreSQL ledger option. Owner-selected Render deployment uses sqlite instead.
DYNO_STORAGE=postgres
# Production SQLite: RENDER_DISK_PATH=/var/data and DYNO_DATABASE_FILE=/var/data/project-dyno/dyno.sqlite
# For local SQLite testing, use an absolute file path inside an ignored private directory.
DYNO_DATABASE_FILE=
# Secret: exactly 32 random bytes, base64-encoded. Set privately; never regenerate at redeploy.
DYNO_STORAGE_KEY=
# Optional read-only indexer in the same web-service instance; NEVER a separate Render disk consumer.
DYNO_INDEXER_ENABLED=false
DYNO_LIVE_ENABLED=false
DYNO_IDENTITY_SECRET=
DYNO_IDENTITY_SIGNER_PRIVATE_KEY=
DYNO_KEEPER_PRIVATE_KEY=
DYNO_KEEPER_LIVE=false
# Absolute path on the keeper's persistent private disk; required before live signing.
DYNO_KEEPER_JOURNAL_PATH=
DYNO_KEEPER_HEALTH_PORT=9464
# Read-only Saigon VRF readiness. Never put a wallet private key in an RPC URL.
SAIGON_RPC_URL=
# Pinned, ephemeral Katana fork checks only. These never write to the source chain.
DYNO_FORK_RPC_URL=
DYNO_FORK_MANIFEST=
DYNO_FORK_BLOCK=
DISCORD_CLIENT_ID=1559100671309905922
DISCORD_CLIENT_SECRET=
# Local redirect. Register it alongside the production redirect in Discord OAuth2 settings.
# Production: https://matttoken.com/api/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback
DISCORD_GUILD_ID=1493734022281429257
# Alchemy Ronin HTTPS endpoint; store the full URL privately in hosting secrets.
RONIN_RPC_URL=
# Ethereum endpoint used only for manual #1358 ownership/delivery reads.
DYNO_ETHEREUM_RPC_URL=

# Contractless CWGUILD Rune Run. Players never approve or wager tokens.
# Live mode requires a dedicated low-balance reward wallet and persistent state.
CWGUILD_LIVE_ENABLED=false
# Practice mode displays 1 / 100 defaults. PRIZE_AMOUNT is the round-one base; the five rounds pay 1x/3x/7x/15x/30x on cash out.
CWGUILD_MIN_BALANCE=
CWGUILD_PRIZE_AMOUNT=
CWGUILD_OPERATOR_PRIVATE_KEY=
# Render example: /var/data/cwguild-arcade-state.json
CWGUILD_STATE_FILE=
