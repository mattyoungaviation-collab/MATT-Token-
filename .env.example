# Public gift-box quotes remain disabled unless both values are configured.
GIFT_BOX_PUBLIC_QUOTES_ENABLED=false
# Set only in the hosting provider's encrypted secret manager. Never commit a key.
GIFT_BOX_QUOTE_PRIVATE_KEY=

# BurnFlip deployment and two-phase Katana V3 oracle configuration.
MATT_TOKEN_ADDRESS=
WRON_TOKEN_ADDRESS=
KATANA_V3_FACTORY=
BURNFLIP_TREASURY=
BURNFLIP_ADMIN=
BURNFLIP_REWARD_VAULT=
BURNFLIP_GAME_DEPLOYMENT=
BURNFLIP_CONFIG=
BURNFLIP_PREPARE_ONLY=false
# Set these only after deployment; the website keeps the replacement disabled until then.
BURNFLIP_CONTRACT_ADDRESS=
BURNFLIP_DEPLOYMENT_BLOCK=
BURNFLIP_STATS_CACHE_TTL_MS=15000
BURNFLIP_HISTORY_FILE=
